{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      ".github/**",
      ".claude/**",
      ".vscode/**",
      ".worktrees/**",
      ".superpowers/**",
      "**/node_modules/**",
      "functions/**",
      "tests/**",
      "docs/**",
      "exports/**",
      "documents/**",
      "data/**",
      "scripts/**",
      "Spark/**",
      "*.db",
      "*.log",
      "*.py",
      "*.txt",
      "CHANGELOG.md",
      "CLAUDE.md",
      "CODEBASE_MAP.md",
      "graphify-out/**"
    ],
    "rewrites": [
      { "source": "/portefeuille", "destination": "/owned.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      },
      {
        "source": "/VERSION",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" },
          { "key": "Content-Type", "value": "text/plain; charset=utf-8" }
        ]
      }
    ]
  }
}
